<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing tokens stay on this phone. They are not copied to cloud backups
     or to a new device; pair again after moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
